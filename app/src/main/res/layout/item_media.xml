<?xml version="1.0" encoding="utf-8"?>
<!-- root container for the entire list item -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/media_item_min_height"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:importantForAccessibility="yes">

    <!-- inner layout that holds the actual content of the item -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="@dimen/layout_zero"
        android:layout_height="@dimen/layout_zero"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="@dimen/space_12"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- thumbnail image wrapper using MaterialCardView for border -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/thumb_wrapper"
            android:layout_width="@dimen/media_thumbnail_size"
            android:layout_height="@dimen/media_thumbnail_size"
            android:minWidth="@dimen/media_thumbnail_size"
            android:minHeight="@dimen/media_thumbnail_size"
            android:maxWidth="@dimen/media_thumbnail_size"
            android:maxHeight="@dimen/media_thumbnail_size"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:stateListAnimator="@null"
            android:duplicateParentState="true"
            android:transitionName="thumb_transition"
            app:cardElevation="@dimen/layout_zero"
            app:cardMaxElevation="@dimen/layout_zero"
            app:cardUseCompatPadding="false"
            app:cardPreventCornerOverlap="false"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="@dimen/stroke_width_thin"
            app:strokeColor="?attr/colorOutline"
            app:shapeAppearanceOverlay="@style/Shape.App.Corner.Small"
            app:rippleColor="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- main image thumbnail -->
            <ImageView
                android:id="@+id/thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                tools:ignore="ContentDescription" />

            <!-- play icon overlay for videos -->
            <ImageView
                android:id="@+id/play_icon"
                android:layout_width="@dimen/media_overlay_size"
                android:layout_height="@dimen/media_overlay_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_play_overlay"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="ContentDescription" />

            <!-- audio icon overlay for audio files -->
            <ImageView
                android:id="@+id/audio_icon"
                android:layout_width="@dimen/media_overlay_size"
                android:layout_height="@dimen/media_overlay_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_audio_overlay"
                android:visibility="gone"
                tools:visibility="visible"
                tools:ignore="ContentDescription" />
        </com.google.android.material.card.MaterialCardView>

        <!-- checkbox for selecting the item -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginEnd="@dimen/layout_zero"
            app:useMaterialThemeColors="true"
            app:layout_constraintTop_toTopOf="@id/thumb_wrapper"
            app:layout_constraintBottom_toBottomOf="@id/thumb_wrapper"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- vertical layout for the file name, meta info, and badge -->
        <LinearLayout
            android:id="@+id/details_container"
            android:layout_width="@dimen/layout_zero"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginEnd="@dimen/layout_zero"
            app:layout_constraintStart_toEndOf="@id/thumb_wrapper"
            app:layout_constraintEnd_toStartOf="@id/check"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- main file or media name -->
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                android:textSize="@dimen/media_text_size"
                tools:text="IMG_1234.JPG" />

            <!-- metadata (date, size, etc.) below the name -->
            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:lineSpacingExtra="@dimen/space_2"
                android:textSize="@dimen/media_text_size"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="2025-10-24 10:30&#10;1.2 MB" />

            <!-- badge label for special states like “trashed” -->
            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:paddingStart="@dimen/space_6"
                android:paddingEnd="@dimen/space_6"
                android:paddingTop="@dimen/space_2"
                android:paddingBottom="@dimen/space_2"
                android:text="@string/badge_trashed"
                android:textSize="@dimen/media_text_size"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_badge_round"
                android:visibility="gone" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- overlay view for highlighting item when selected -->
    <View
        android:id="@+id/overlay"
        android:layout_width="@dimen/layout_zero"
        android:layout_height="@dimen/layout_zero"
        android:layout_marginStart="@dimen/layout_zero"
        android:layout_marginTop="@dimen/layout_zero"
        android:layout_marginEnd="@dimen/layout_zero"
        android:layout_marginBottom="@dimen/layout_zero"
        android:background="@color/selection_highlight"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
